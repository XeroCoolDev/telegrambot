# Telegram — Reseller Bot
BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://telegrambot.yourdomain.tld
ADMIN_TELEGRAM_IDS=
ADMIN_CHAT_ID=

# Telegram — Customer Bot
CUSTOMER_BOT_TOKEN=
CUSTOMER_BOT_USERNAME=
CUSTOMER_WEBAPP_URL=
CUSTOMER_ENABLED_RESELLERS=
SUPPORT_FORUM_CHAT_ID=

# XUI — Admin API (for adjusting credits, fetching users/lines, editing lines)
XUI_ADMIN_API_URL=https://your-xui-panel.com/api.php
XUI_ADMIN_API_KEY=your_admin_api_key

# XUI — Reseller API (for creating lines, extending via user's own api_key)
XUI_RESELLER_API_URL=https://your-xui-panel.com/api-reseller.php

# BTCPay
BTCPAY_URL=https://your-btcpay.com
BTCPAY_API_KEY=your_btcpay_api_key
BTCPAY_STORE_ID=your_store_id
BTCPAY_POS_APP_ID=your_pos_app_id
BTCPAY_WEBHOOK_SECRET=your_webhook_secret

# App
DATABASE_PATH=/app/data/bot.db
API_TIMEOUT_MS=10000
REMINDER_CRON=0 9 * * *
EXPIRY_REMINDER_DAYS=1
TOPUP_REMINDER_DAYS=30
ADULT_BOUQUET_IDS=

# Connection upgrades (from-to=standard,discounted)
CONN_PRICE_1_2=4,2
CONN_PRICE_1_3=7,4
CONN_PRICE_2_3=3,2
MAX_CONNECTIONS=3
CONN_DISCOUNT_MONTHS=6
CONN_MULTIPLIER_MONTHS=12
EXTEND_CONN_LOCK_DAYS=30

# Rate limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
ADMIN_DASHBOARD_TOKEN=
