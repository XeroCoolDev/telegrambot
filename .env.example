# ── Telegram — XeroCool Bot (reseller) ──
XEROCOOL_BOT_TOKEN=your_bot_token_here
XEROCOOL_WEBAPP_URL=https://xerocool-bot.yourdomain.tld
XEROCOOL_ADMIN_TELEGRAM_IDS=
XEROCOOL_ADMIN_CHAT_ID=

# ── Telegram — Xposed Bot (customer-facing) ──
XPOSED_BOT_TOKEN=
XPOSED_WEBAPP_URL=https://xposed-bot.yourdomain.tld
XPOSED_SUPPORT_CHAT_ID=
XPOSED_AUTHORISED_TELEGRAM_IDS=

# ── XUI Panel ──
XUI_ADMIN_API_URL=https://your-xui-panel.com/api.php
XUI_ADMIN_API_KEY=your_admin_api_key
XUI_RESELLER_API_URL=https://your-xui-panel.com/api-reseller.php
XUI_ADULT_BOUQUET_IDS=

# ── BTCPay (reseller credit purchases) ──
BTCPAY_URL=https://your-btcpay.com
BTCPAY_API_KEY=your_btcpay_api_key
BTCPAY_STORE_ID=your_store_id
BTCPAY_POS_APP_ID=your_pos_app_id
BTCPAY_WEBHOOK_SECRET=your_webhook_secret

# ── App ──
DATABASE_PATH=/app/data/bot.db
API_TIMEOUT_MS=10000

# ── Reminders / scheduling ──
REMINDER_CRON=0 9 * * *
EXPIRY_REMINDER_DAYS=1
TOPUP_REMINDER_DAYS=30

# ── Business rules (XeroCool pricing & limits) ──
MAX_CONNECTIONS=3
CONN_PRICE_1_2=4,2
CONN_PRICE_1_3=7,4
CONN_PRICE_2_3=3,2
CONN_DISCOUNT_MONTHS=6
CONN_MULTIPLIER_MONTHS=12
EXTEND_CONN_LOCK_DAYS=30

# ── Rate limiting ──
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
